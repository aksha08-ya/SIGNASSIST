# SIGNASSIST Environment Configuration Example
# Copy this file to .env and adjust values for your local environment.

SIGNASSIST_ENV=development
SIGNASSIST_LOG_LEVEL=INFO
SIGNASSIST_DEVICE=auto
SIGNASSIST_DATA_DIR=data
SIGNASSIST_MODELS_DIR=models
SIGNASSIST_REPORTS_DIR=reports
SIGNASSIST_CONFIDENCE_THRESHOLD=0.70
GEMINI_API_KEY=
